{
  "name": "@deskbell/sdk",
  "version": "0.2.0",
  "description": "Typed client for the Deskbell public API: streamed answers, conversations, feedback.",
  "license": "MIT",
  "homepage": "https://deskbell.dev/docs/developer/sdk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deskbellhq/deskbell.git",
    "directory": "packages/sdk"
  },
  "bugs": "https://github.com/deskbellhq/deskbell/issues",
  "keywords": [
    "deskbell",
    "sdk",
    "client",
    "api",
    "sse",
    "docs",
    "support",
    "ai"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@deskbell/shared": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
