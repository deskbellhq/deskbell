{
  "name": "@deskbell/widget",
  "version": "0.3.0",
  "description": "The Deskbell widget as a custom element: shadow DOM, Preact, brandable through tokens, parts and slots.",
  "license": "MIT",
  "homepage": "https://deskbell.dev/docs/widget/install",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deskbellhq/deskbell.git",
    "directory": "packages/widget-core"
  },
  "bugs": "https://github.com/deskbellhq/deskbell/issues",
  "keywords": [
    "deskbell",
    "widget",
    "web-component",
    "custom-element",
    "docs",
    "support",
    "chat",
    "ai"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "node build.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@deskbell/sdk": "workspace:*",
    "@deskbell/shared": "workspace:*",
    "preact": "^10.29.0"
  },
  "devDependencies": {
    "@testing-library/preact": "^3.2.4",
    "esbuild": "^0.25.0",
    "happy-dom": "^20.14.5",
    "preact-render-to-string": "^6.7.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
