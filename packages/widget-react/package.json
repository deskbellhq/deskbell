{
  "name": "@deskbell/widget-react",
  "version": "0.3.0",
  "description": "React wrapper around the Deskbell widget custom element.",
  "license": "MIT",
  "homepage": "https://deskbell.dev/docs/widget/install#react",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deskbellhq/deskbell.git",
    "directory": "packages/widget-react"
  },
  "bugs": "https://github.com/deskbellhq/deskbell/issues",
  "keywords": [
    "deskbell",
    "widget",
    "react",
    "docs",
    "support",
    "chat",
    "ai"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.tsx"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "dependencies": {
    "@deskbell/shared": "workspace:*",
    "@deskbell/widget": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "react": "^19.2.0",
    "typescript": "^5.9.0"
  }
}
