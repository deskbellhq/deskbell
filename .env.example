# Database (the only required infra — D11)
DATABASE_URL=postgres://deskbell:deskbell@localhost:5432/deskbell

# Auth (better-auth) — signs dashboard session cookies. REQUIRED in
# production (compose refuses to start without it); generate with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=change-me
# Externally visible origin of this deployment. Also the base of the
# invitation links the Members page renders — set it to the real URL before
# inviting anyone.
BETTER_AUTH_URL=http://localhost:3000

# Google sign-in (optional, spec: sign-in-with-google) — a login method for
# dashboard members, off until both are set. Create an OAuth client in Google
# Cloud with the redirect URI <BETTER_AUTH_URL>/api/auth/callback/google.
# The same invitation rule applies; admins can also allow whole email domains
# under Settings › Members.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Outbound email (optional) — powers self-serve password reset and
# invitation emails. Any SMTP
# provider or local dev tool works; both variables are required together.
# Postmark example (the Server API token is both username and password):
#   SMTP_URL=smtp://YOUR_SERVER_TOKEN:YOUR_SERVER_TOKEN@smtp.postmarkapp.com:587
#   EMAIL_FROM="Deskbell <deskbell@your-domain.com>"    # a sender your provider accepts
# Local dev: leave unset and reset links print to the server console, or run
# Mailpit and point SMTP_URL=smtp://localhost:1025 at it. In production,
# leaving this unset disables the forgot-password flow (the page says so);
# invitations then remain hand-over links, which always work regardless.
# SMTP_URL=
# EMAIL_FROM=

# Models (D4: any provider, or local via Ollama — configure at least one)
# Ids are provider/model. Wired: openai/* (chat + embeddings), anthropic/*
# (chat only — Anthropic has no embeddings API), google/* (chat + embeddings;
# embeddings are requested at the column's 1536 dimensions), ollama/* (chat +
# embeddings, your hardware, no hosted key; also the escape hatch for anything
# speaking the OpenAI-compatible protocol — point OLLAMA_BASE_URL at it).
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434
DESKBELL_CHAT_MODEL=openai/gpt-5-mini
# DESKBELL_CHAT_MODEL=anthropic/claude-opus-5
# DESKBELL_CHAT_MODEL=google/gemini-3.6-flash
# DESKBELL_CHAT_MODEL=ollama/llama3.3
# How hard a reasoning model may think before its first visible token, on the
# answer path (chat, planner, LLM reranker): low (default) | none | minimal |
# medium | high | provider (send nothing, take the provider's default). At the
# provider default the chat model deliberates for eight to eleven seconds
# before a one-paragraph grounded answer; low halves that. minimal is faster
# still but refuses questions the context answers. none switches reasoning off
# on models that allow it; the older ones reject it with a 400. Only openai/*
# has the setting today — elsewhere it is a no-op.
# DESKBELL_REASONING_EFFORT=low
DESKBELL_EMBEDDING_MODEL=openai/text-embedding-3-small
# The embedding column is 1536-dimensional per deployment. A model with a
# different dimension (most local ones: nomic-embed-text is 768) needs the
# vector(1536) migration first — the reindex job refuses the mismatch and
# names it rather than half-applying (spec: ingestion-pipeline).
# DESKBELL_EMBEDDING_MODEL=google/gemini-embedding-001
# DESKBELL_EMBEDDING_MODEL=ollama/nomic-embed-text

# Chunking (spec: chunking-experiments). How pages are cut before embedding:
# the size a chunk aims for, the hard cap before a block is split, and the tail
# of the previous chunk carried into the next. Chunk size changes what every
# embedding is computed from, so change it against eval numbers and re-sync
# your sources afterwards — stored chunks keep the size they were cut at.
# DESKBELL_CHUNK_TARGET_CHARS=2800
# DESKBELL_CHUNK_MAX_CHARS=3600
# DESKBELL_CHUNK_OVERLAP_CHARS=350

# Query planning (spec: grounded-generation)
# Before searching, the question is rewritten to stand on its own — "and how do
# I configure it?" becomes a question with a subject. Without this a follow-up
# is searched as typed, and "it" matches nothing in particular.
#   followups  plan when the conversation has history (default)
#   always     also expand first turns into several angles — better retrieval,
#              one extra model call on every question
#   off        search the message exactly as typed
# DESKBELL_QUERY_PLANNING=followups
# Defaults to DESKBELL_CHAT_MODEL. Set separately so changing the model that
# writes answers cannot silently change how questions are resolved. A cheap,
# fast model is the right choice here.
# DESKBELL_PLANNER_MODEL=
# The model that grades answers in `pnpm evals --judge llm`. Defaults to
# DESKBELL_CHAT_MODEL, which means the model grades its own work; a different
# model is a more credible judge (see the Evaluation page).
# DESKBELL_JUDGE_MODEL=

# Retrieval (spec: grounded-generation, hybrid-retrieval)
# Cosine-similarity floor under retrieved chunks: 0 (off — the default) to 1.
# NOT a quality dial. Zero chunks above the floor refuses the question before
# the model is ever consulted, and correct documents routinely score poorly —
# raising this trades answers for silence. The model's grounding contract is
# what keeps answers honest; tune this only against eval numbers
# (apps/docs/content/docs/operate/evaluation.mdx).
# DESKBELL_RETRIEVAL_MIN_SCORE=0
#
# Hybrid retrieval. The defaults preserve plain vector search; every knob below
# changes RANKING, so flip them against eval numbers, not by feel. The sizing
# knobs are a LATENCY BUDGET — turning them up buys latency and tokens first,
# quality only if a measurement says so.
#   hybrid   adds a full-text leg beside the vector leg and fuses the two —
#            exact tokens (error codes, config keys, identifiers) can match
#            literally where embeddings miss them
# DESKBELL_RETRIEVAL_MODE=vector
#   on       also searches the planner's variant phrasings and pools the
#            candidates (needs DESKBELL_QUERY_PLANNING not off; the variants
#            each cost an embedding call)
# DESKBELL_RETRIEVAL_MULTI_QUERY=off
# Per-leg candidate depth before results fuse.
# DESKBELL_RETRIEVAL_LEG_DEPTH=50
# How many candidates the vector index examines per query (pgvector's
# hnsw.ef_search). The index is approximate: too shallow a scan misses pages an
# exact scan would find, and the tenant filter runs after the scan. Costs
# milliseconds; 100 recovered everything pgvector's own 40 lost on the eval set.
# DESKBELL_RETRIEVAL_EF_SEARCH=100
# Pooled candidates handed to final ordering (and the reranker, if one is on).
# DESKBELL_RETRIEVAL_POOL=24
# Max chunks from one document in the final selection; 0 = off. Stops one long
# page from crowding out short pages that answer the question outright — the
# single biggest retrieval gain measured so far. Raise it if your pages carry
# long procedures whose steps span chunks.
# DESKBELL_RETRIEVAL_MAX_PER_DOC=1
# Final ordering when no reranker runs: fused (rank-fusion order) or cosine.
# DESKBELL_RETRIEVAL_ORDER=fused

# Reranking (spec: hybrid-retrieval, local-cross-encoder-reranker). Off by
# default; never a sidecar service (D11). Turn a driver on only when eval
# numbers show it earns its latency.
#   llm    one structured call to a chat model reorders the pooled candidates —
#          zero new dependencies, but seconds of latency and tokens per answer
#   local  a real cross-encoder runs IN-PROCESS on CPU (~tens of ms per
#          candidate, no tokens). Needs the optional dependency
#          @huggingface/transformers installed next to the app; model weights
#          (~25 MB) download from the Hugging Face hub on first use and cache
#          locally — pre-seed the cache for air-gapped deployments.
# DESKBELL_RERANK=off
# llm: defaults to DESKBELL_CHAT_MODEL (a fast non-reasoning model ranks in a
# fraction of the time a reasoning model takes).
# local: a cross-encoder id on the Hugging Face hub, ONNX weights; default
# Xenova/ms-marco-MiniLM-L-6-v2.
# DESKBELL_RERANK_MODEL=
# llm only. Past the timeout the answer proceeds in fusion order — reranking
# may cost quality, never availability. The local driver takes no timeout (a
# native forward pass cannot be aborted); its batch is bounded instead.
# DESKBELL_RERANK_TIMEOUT_MS=10000

# Clarifying questions (spec: clarifying-questions). on: when the retrieved
# pages answer the question in more than one way, the engine asks which the
# visitor meant and offers those pages as options, at most once per
# conversation. Changes what the visitor gets; flip it against eval numbers.
# DESKBELL_CLARIFY=off
# Answer verification (spec: answer-verification). on (the default): the
# model is asked to bold the names it asserts, and after the answer streams
# each name is looked up in the retrieved pages and then in the whole index.
# A name found nowhere is spoken as a caveat under the answer and flagged on
# the Gaps page. Adds a paragraph to the prompt and one query per answer;
# off restores the shorter prompt and records every answer as unchecked.
# DESKBELL_VERIFY=on

# Vector store (spec: weaviate-vector-store, vector-store-single-home).
# pgvector inside Postgres is the default and the only driver the install
# needs. `weaviate` puts the chunk index in a Weaviate cluster YOU run —
# Deskbell never starts one. A vector lives in exactly one store: choose
# before adding sources, because changing this later means re-embedding
# everything (Sources › Re-embed; the page says so). The client ships with
# the images and with `pnpm install`; with the driver selected and the
# package somehow missing, both processes fail loudly rather than quietly
# using pgvector. Set the same values on both processes.
# DESKBELL_VECTOR_STORE=pgvector
# REST endpoint; the gRPC endpoint defaults to the same host on port 50051.
# WEAVIATE_URL=http://localhost:8080
# WEAVIATE_GRPC_URL=
# WEAVIATE_API_KEY=
# Collection name — starts with a capital letter; one Deskbell install each.
# WEAVIATE_COLLECTION=DeskbellChunk

# Docs gaps (spec: answer-signal). An answered question counts as a gap when
# the best retrieved match scored under this floor — the evidence was weak
# even though nobody marked the answer down. Calibrated on the shipped
# embedding model; a different embedding model moves the whole scale, so
# re-measure before trusting the default with one.
# DESKBELL_GAPS_WEAK_SCORE=0.35
# Gap questions are grouped by meaning (spec: gap-clusters): a new wording is
# compared with every wording the project has seen and joins that one's cluster
# when the cosine similarity reaches this value, and starts a new cluster
# otherwise. Also a property of the embedding model; re-cluster from the
# dashboard after changing either. Higher splits more, lower merges more.
# What is removed from a question before it is embedded — a product name, say —
# is per project and lives in the dashboard: Settings -> Gaps.
# DESKBELL_GAPS_CLUSTER_SIMILARITY=0.80
# Analysis (spec: gap-analysis): an editor can ask the configured chat model
# what a cluster of unanswered questions is missing and what to write. It
# counts against the project's daily token budget. Set this to a number of
# occurrences in the last 30 days at which a cluster without an analysis is
# analysed without a click; 0 (the default) means only on request.
# DESKBELL_GAPS_AUTO_ANALYZE_AT=0
# The model that writes gap analyses. Defaults to DESKBELL_CHAT_MODEL; set it
# to a stronger model for better findings or a cheaper one for volume.
# DESKBELL_GAP_ANALYST_MODEL=
# Past the timeout the analysis fails and the cluster records the error.
# DESKBELL_GAP_ANALYST_TIMEOUT_MS=30000

# Conversations (spec: conversation-context-and-titles). How a new thread gets
# its title: first-message (the default; the question, trimmed, no cost) or
# model (one short chat-model call per new conversation, run by the worker,
# counted against the project's daily token budget).
# DESKBELL_THREAD_TITLES=first-message

# Notifications (spec: project-notifications) — whether a Slack or webhook
# notification carries a one-sentence model summary: model (the default; one
# short chat-model call per event, run by the worker, counted against the
# project's daily token budget) or none (the conversation title instead).
# Targets themselves are set per project under Settings › Notifications.
# DESKBELL_NOTIFICATION_SUMMARY=model

# Actions (spec: mcp-actions). Servers and tool policies are set per project
# under Settings › Actions; these bound what one turn may do.
# Model steps per turn (each tool call is a step), per-call timeout, how much
# of a result the model is shown, and how long a confirmation card can be
# answered. The approval signature is derived from BETTER_AUTH_SECRET.
# DESKBELL_ACTION_MAX_STEPS=4
# DESKBELL_ACTION_TIMEOUT_MS=30000
# DESKBELL_ACTION_RESULT_MAX_CHARS=8000
# DESKBELL_ACTION_APPROVAL_TTL_MIN=10

# Abuse protection (spec: widget-abuse-protection — see the security guide:
# apps/docs/content/docs/security.mdx)
# Defaults are ON and sane; raise them deliberately, never by reflex.
#
# Empty allowlist behaviour: development answers any origin so the demo works,
# production refuses. Set this only if you embed on many domains you cannot list.
# DESKBELL_ALLOW_ANY_ORIGIN=false
# Master off switch. Load testing or a trusted private network only.
# DESKBELL_ABUSE_PROTECTION_DISABLED=false
# DESKBELL_RATE_LIMIT_ASK_PER_MIN=10        # answers per IP per minute
# DESKBELL_RATE_LIMIT_ASK_PER_HOUR=100      # answers per IP per hour
# DESKBELL_RATE_LIMIT_PROJECT_PER_MIN=120   # answers per project per minute
# DESKBELL_RATE_LIMIT_READ_PER_MIN=60       # cheap endpoints, per IP per minute
# DESKBELL_MAX_CONCURRENT_ASKS=2            # simultaneous streams per IP, per instance
# How many reverse proxies sit in front of this deployment. 0 for a direct run;
# getting it wrong makes every caller share one rate-limit bucket, or none.
# DESKBELL_TRUSTED_PROXIES=0
# HMAC key for the IP hashes in rate_limits. Defaults to BETTER_AUTH_SECRET.
# DESKBELL_IP_SALT=

# Deployment (optional) — external origin used when rendering embed snippets on
# the Deploy page; derived from request headers when unset. Set it when a proxy
# strips x-forwarded-* headers.
# DESKBELL_PUBLIC_URL=https://deskbell.your-domain.com

# Enterprise Edition (optional — see packages/ee/FEATURES)
# DESKBELL_EE_LICENSE_KEY=
