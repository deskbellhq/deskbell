# deps
node_modules/

# builds
.next/
dist/
out/
.turbo/

# env — never commit secrets
.env
.env.*
!.env.example

# db
*.sqlite

# evals — question sets built against a corpus that is not ours to republish,
# and everything derived from one. A baseline lists every case id and score;
# a report carries every question verbatim. The directories are
# tracked so the convention is discoverable; their contents never are.
packages/evals/datasets/private/*
!packages/evals/datasets/private/.gitkeep
packages/evals/baselines/private/*
!packages/evals/baselines/private/.gitkeep
packages/evals/reports/*
!packages/evals/reports/.gitkeep

# browser tests (spec: dashboard-browser-tests): artifacts and the saved session
apps/web/test-results/
apps/web/playwright-report/
apps/web/e2e/.auth/

# misc
.DS_Store
*.log
coverage/
.vercel/

# ts incremental build info
*.tsbuildinfo

# generated by next dev / next typegen; its contents are an implementation
# detail and flip between .next/types and .next/dev/types depending on which
# command ran last. Next's own docs say not to track it.
next-env.d.ts
